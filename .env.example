# Database
POSTGRES_USER=joblead
POSTGRES_PASSWORD=joblead_secret
POSTGRES_DB=joblead
POSTGRES_PORT=5432
DATABASE_URL=postgresql://joblead:joblead_secret@localhost:5432/joblead

# JWT
JWT_SECRET=change_me_super_secret_jwt_key_at_least_32_chars
JWT_REFRESH_SECRET=change_me_super_secret_refresh_key_at_least_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# API
API_PORT=3001
NODE_ENV=development

# File uploads (dev: local directory)
UPLOAD_DIR=./uploads

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001
WEB_PORT=3000

# Rate limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=10
